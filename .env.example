# SAFEORA Environment Configuration

# Database
# For immediate local development (zero external setup):
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/safeora_vault?schema=public"

# Authentication & Session Security
# 32+ byte random hex or base64 key
SESSION_SECRET="safeora_vault_super_secret_session_key_32bytes_min_2026"
SESSION_EXPIRY_HOURS="24"

# Integrity Manifest Signing Key (Ed25519 or HMAC-SHA256 secret)
# In production, held in a separate KMS / HSM security boundary
MANIFEST_SIGNING_SECRET="safeora_manifest_signing_ed25519_key_secret_vault_guard_2026"

# Storage Configuration
# local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_BASE_DIR="./storage/uploads"
STORAGE_RECOVERY_BASE_DIR="./storage/recovery"
STORAGE_FIXTURES_BASE_DIR="./storage/fixtures"

# S3 Configuration (Optional for production deployment)
# S3_ENDPOINT="https://s3.amazonaws.com"
# S3_REGION="us-east-1"
# S3_BUCKET_PRIMARY="safeora-vault-primary"
# S3_BUCKET_RECOVERY="safeora-vault-recovery-isolated"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Application
NEXT_PUBLIC_APP_NAME="SAFEORA — Self-Defending Document Vault"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
